`timescale 1ns / 1ps
module tu_ctrl #(
    parameter N = 16
)(
    input  wire        clk,
    input  wire        rst_n,
    input  wire        start,
    input  wire [1:0]  mode,
    output reg         busy,
    output reg         done,
    output reg         err,
    output reg  [2:0]  mode_oh,
    output reg  [2:0]  gate,
    output reg         in_valid,
    output reg         clr_acc
);
    localparam LATENCY = 3 * N - 1; // 47 cycles for N=16
    localparam S_IDLE  = 2'd0;
    localparam S_FEED  = 2'd1;
    localparam S_WAIT  = 2'd2;
    localparam S_DONE  = 2'd3;

    reg [1:0] state;
    reg [5:0] cnt;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state    <= S_IDLE;
            cnt      <= 6'd0;
            busy     <= 1'b0;
            done     <= 1'b0;
            err      <= 1'b0;
            mode_oh  <= 3'b000;
            gate     <= 3'b000;
            in_valid <= 1'b0;
            clr_acc  <= 1'b0;
        end else begin
            case (state)
                S_IDLE: begin
                    done     <= 1'b0;
                    in_valid <= 1'b0;
                    clr_acc  <= 1'b0;
                    if (start) begin
                        if (mode == 2'b11) begin
                            err   <= 1'b1;
                            busy  <= 1'b0;
                            state <= S_IDLE;
                        end else begin
                            err  <= 1'b0;
                            busy <= 1'b1;
                            cnt  <= 6'd0;
                            case (mode)
                                2'b00: begin mode_oh <= 3'b001; gate <= 3'b001; end
                                2'b01: begin mode_oh <= 3'b010; gate <= 3'b011; end
                                2'b10: begin mode_oh <= 3'b100; gate <= 3'b111; end
                                default: begin mode_oh <= 3'b000; gate <= 3'b000; end
                            endcase
                            clr_acc  <= 1'b1;
                            in_valid <= 1'b1;
                            state    <= S_FEED;
                        end
                    end else begin
                        busy    <= 1'b0;
                        mode_oh <= 3'b000;
                        gate    <= 3'b000;
                    end
                end

                S_FEED: begin
                    clr_acc <= 1'b0;
                    cnt     <= cnt + 1'b1;
                    if (cnt == N - 1) begin
                        in_valid <= 1'b0;
                        state    <= S_WAIT;
                    end
                end

                S_WAIT: begin
                    cnt <= cnt + 1'b1;
                    if (cnt == LATENCY - 1) begin
                        done  <= 1'b1;
                        busy  <= 1'b0;
                        state <= S_DONE;
                    end
                end

                S_DONE: begin
                    done  <= 1'b0;
                    state <= S_IDLE;
                end
            endcase
        end
    end
endmodule
